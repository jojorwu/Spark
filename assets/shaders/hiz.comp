#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D inDepth;
layout (binding = 1, r32f) uniform writeonly image2D outDepth;

layout (push_constant) uniform PushConstants {
    vec2 size; // Destination size
} push;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(push.size.x) || pos.y >= int(push.size.y)) return;

    // Source coordinates in the previous mip level
    ivec2 srcPos = pos * 2;

    // Read 4 pixels from the previous level using texelFetch for point-sampling precision
    float d0 = texelFetch(inDepth, srcPos + ivec2(0, 0), 0).r;
    float d1 = texelFetch(inDepth, srcPos + ivec2(1, 0), 0).r;
    float d2 = texelFetch(inDepth, srcPos + ivec2(0, 1), 0).r;
    float d3 = texelFetch(inDepth, srcPos + ivec2(1, 1), 0).r;

    // For conservative occlusion culling with standard [0, 1] depth:
    // If object_min_z > background_max_z, then the object is occluded.
    // Therefore, we need a MAX reduction pyramid to represent the farthest point in each region.
    float maxDepth = max(max(d0, d1), max(d2, d3));

    imageStore(outDepth, pos, vec4(maxDepth));
}
