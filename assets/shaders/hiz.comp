#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D inDepth;
layout (binding = 1, r32f) uniform writeonly image2D outDepth;

layout (push_constant) uniform PushConstants {
    vec2 size; // Destination size
} push;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= push.size.x || pos.y >= push.size.y) return;

    // Source coordinates
    vec2 uv = (vec2(pos) + 0.5) / push.size;

    // Sample 4 pixels from the previous level
    // We use a manual reduction to get the max depth (furthest) for min-depth culling
    // Wait, for occlusion culling, we want the MIN depth (closest point in that area)
    // to check if our object is behind it.
    // So if object_min_depth > pyramid_max_depth, it's occluded.
    // Or if we use reversed-Z, if object_max_depth < pyramid_min_depth, it's occluded.
    // Assuming standard Z [0, 1] and MIN reduction:
    // We want the MAX depth in the quad to be conservative? No.
    // If we want to know if an object is occluded, we compare its NEAREST depth to the FARTHEST depth of the background in that area.
    // Actually, usually Hi-Z uses a MIN reduction (closest depth) if you want to check if something is IN FRONT of something else.
    // For occlusion: if object_nearest_z > hi_z_farthest_z, it's occluded.
    // So we need a MAX reduction pyramid.

    vec4 depths;
    depths.x = textureOffset(inDepth, uv, ivec2(0, 0)).r;
    depths.y = textureOffset(inDepth, uv, ivec2(1, 0)).r;
    depths.z = textureOffset(inDepth, uv, ivec2(0, 1)).r;
    depths.w = textureOffset(inDepth, uv, ivec2(1, 1)).r;

    float maxDepth = max(max(depths.x, depths.y), max(depths.z, depths.w));

    imageStore(outDepth, pos, vec4(maxDepth));
}
