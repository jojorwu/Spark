#version 450

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct ObjectData {
    vec4 modelRow0;
    vec4 modelRow1;
    vec4 modelRow2;
    vec4 sphere; // xyz = center, w = radius
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint materialIndex;
};

layout(set = 0, binding = 0) uniform GlobalUBO {
    mat4 viewProj;
    mat4 lightViewProj;
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 frustum[6];
} global;

layout(std430, set = 0, binding = 1) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 0, binding = 2) buffer IndirectBuffer {
    DrawCommand commands[];
};

layout(std430, set = 0, binding = 3) buffer CountBuffer {
    uint drawCount;
};

layout(set = 0, binding = 4) uniform sampler2D hizPyramid;

layout(push_constant) uniform PC {
    uint lightCount;
    float metallic;
    float roughness;
    float width;
    float height;
    uint  padding;
    uint64_t objectBufferAddress;
    mat4 prevViewProj;
    uint64_t vertexBufferAddress;
} push;

layout(local_size_x = 256) in;

bool sphereInFrustum(vec3 center, float radius) {
    for (int i = 0; i < 6; i++) {
        if (dot(global.frustum[i].xyz, center) + global.frustum[i].w < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= objects.length()) return;

    ObjectData obj = objects[idx];

    // Efficiently transform sphere center from rows
    vec3 center;
    center.x = dot(obj.modelRow0, vec4(obj.sphere.xyz, 1.0));
    center.y = dot(obj.modelRow1, vec4(obj.sphere.xyz, 1.0));
    center.z = dot(obj.modelRow2, vec4(obj.sphere.xyz, 1.0));

    // Calculate max scale to conservatively scale the radius
    float maxScale = max(length(obj.modelRow0.xyz), max(length(obj.modelRow1.xyz), length(obj.modelRow2.xyz)));
    float radius = obj.sphere.w * maxScale;

    if (sphereInFrustum(center, radius)) {
        // Occlusion Culling
        vec4 clipPos = global.viewProj * vec4(center, 1.0);
        clipPos.xyz /= clipPos.w;
        vec2 uv = clipPos.xy * 0.5 + 0.5;
        // Flip Y for Vulkan
        uv.y = 1.0 - uv.y;

        float sphereDepth = clipPos.z;

        // Calculate appropriate mip level based on project sphere size
        float diameter = (2.0 * radius) / clipPos.w;
        float screenPixelSize = diameter * max(push.width, push.height);
        float mipLevel = floor(log2(screenPixelSize));

        float maxDepth = textureLod(hizPyramid, uv, mipLevel).r;

        if (sphereDepth > maxDepth + 0.0001) {
            return; // Occluded
        }

        uint cmdIdx = atomicAdd(drawCount, 1);
        commands[cmdIdx].indexCount = obj.indexCount;
        commands[cmdIdx].instanceCount = 1;
        commands[cmdIdx].firstIndex = obj.firstIndex;
        commands[cmdIdx].vertexOffset = obj.vertexOffset;
        commands[cmdIdx].firstInstance = idx; // used as object ID in vertex shader
    }
}
