#version 450

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct ObjectData {
    mat4 model;
    vec4 sphere; // xyz = center, w = radius
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint materialIndex;
};

layout(set = 0, binding = 0) uniform GlobalUBO {
    mat4 viewProj;
    mat4 lightViewProj;
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 frustum[6];
} global;

layout(std430, set = 0, binding = 1) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 0, binding = 2) buffer IndirectBuffer {
    DrawCommand commands[];
};

layout(std430, set = 0, binding = 3) buffer CountBuffer {
    uint drawCount;
};

layout(set = 0, binding = 4) uniform sampler2D hizPyramid;

layout(local_size_x = 256) in;

bool sphereInFrustum(vec3 center, float radius) {
    for (int i = 0; i < 6; i++) {
        if (dot(global.frustum[i].xyz, center) + global.frustum[i].w < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= objects.length()) return;

    ObjectData obj = objects[idx];
    vec3 center = (obj.model * vec4(obj.sphere.xyz, 1.0)).xyz;
    float radius = obj.sphere.w; // Simplified scaling

    if (sphereInFrustum(center, radius)) {
        // Occlusion Culling
        vec4 clipPos = global.viewProj * vec4(center, 1.0);
        clipPos.xyz /= clipPos.w;
        vec2 uv = clipPos.xy * 0.5 + 0.5;
        // Flip Y for Vulkan
        uv.y = 1.0 - uv.y;

        float sphereDepth = clipPos.z; // Depth of center
        // To be conservative, we should use the depth of the closest point on the sphere
        // but this is a reasonable approximation for now.

        // We use the depth pyramid to check if the sphere is occluded.
        // We need to pick a mip level based on the screen-space size of the sphere.
        // Simplified: just use mip 0 for now to test the logic.
        float maxDepth = textureLod(hizPyramid, uv, 0).r;

        if (sphereDepth > maxDepth + 0.0001) {
            return; // Occluded
        }

        uint cmdIdx = atomicAdd(drawCount, 1);
        commands[cmdIdx].indexCount = obj.indexCount;
        commands[cmdIdx].instanceCount = 1;
        commands[cmdIdx].firstIndex = obj.firstIndex;
        commands[cmdIdx].vertexOffset = obj.vertexOffset;
        commands[cmdIdx].firstInstance = idx; // used as object ID in vertex shader
    }
}
