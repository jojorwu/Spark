#version 450

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct ObjectData {
    vec4 modelRow0;
    vec4 modelRow1;
    vec4 modelRow2;
    vec4 sphere; // xyz = center, w = radius
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint materialIndex;
};

layout(set = 0, binding = 0) uniform GlobalUBO {
    mat4 viewProj;
    mat4 lightViewProj;
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 frustum[6];
} global;

layout(std430, set = 0, binding = 1) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 0, binding = 2) buffer IndirectBuffer {
    DrawCommand commands[];
};

layout(std430, set = 0, binding = 3) buffer CountBuffer {
    uint drawCount;
};

layout(set = 0, binding = 4) uniform sampler2D hizPyramid;

layout(push_constant) uniform PC {
    uint lightCount;
    float metallic;
    float roughness;
    float width;
    float height;
    uint  padding;
    uint64_t objectBufferAddress;
    mat4 prevViewProj;
    uint64_t vertexBufferAddress;
} push;

layout(local_size_x = 256) in;

bool sphereInFrustum(vec3 center, float radius) {
    for (int i = 0; i < 6; i++) {
        if (dot(global.frustum[i].xyz, center) + global.frustum[i].w < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= objects.length()) return;

    ObjectData obj = objects[idx];

    // Efficiently transform sphere center from rows
    vec3 center;
    center.x = dot(obj.modelRow0, vec4(obj.sphere.xyz, 1.0));
    center.y = dot(obj.modelRow1, vec4(obj.sphere.xyz, 1.0));
    center.z = dot(obj.modelRow2, vec4(obj.sphere.xyz, 1.0));

    // Calculate max scale to conservatively scale the radius
    float maxScale = max(length(obj.modelRow0.xyz), max(length(obj.modelRow1.xyz), length(obj.modelRow2.xyz)));
    float radius = obj.sphere.w * maxScale;

    if (sphereInFrustum(center, radius)) {
        // Occlusion Culling
        vec4 clipPos = global.viewProj * vec4(center, 1.0);
        float sphereDepth = clipPos.z / clipPos.w;

        // Project sphere to screen space AABB for conservative footprint calculation
        // This is a simplified conservative approach: project center and use projected radius
        vec2 uv = (clipPos.xy / clipPos.w) * 0.5 + 0.5;
        uv.y = 1.0 - uv.y;

        float diameter = (2.0 * radius) / clipPos.w;
        float screenPixelSize = diameter * max(push.width, push.height);
        float mipLevel = floor(log2(screenPixelSize));

        // For conservative occlusion, we sample a 2x2 footprint in the pyramid
        // to ensure we cover the entire object footprint.
        // Standard textureLod uses bilinear or point sampling.
        // We manually sample the 2x2 neighborhood at the appropriate mip level.
        float d00 = textureLodOffset(hizPyramid, uv, mipLevel, ivec2(0, 0)).r;
        float d10 = textureLodOffset(hizPyramid, uv, mipLevel, ivec2(1, 0)).r;
        float d01 = textureLodOffset(hizPyramid, uv, mipLevel, ivec2(0, 1)).r;
        float d11 = textureLodOffset(hizPyramid, uv, mipLevel, ivec2(1, 1)).r;

        // We take the MAX depth (farthest point) of the 2x2 footprint.
        // If the object's NEAREST point (sphereDepth) is farther than the background's FARTHEST point, it's occluded.
        float maxDepth = max(max(d00, d10), max(d01, d11));

        if (sphereDepth > maxDepth + 0.0001) {
            return; // Occluded
        }

        uint cmdIdx = atomicAdd(drawCount, 1);
        commands[cmdIdx].indexCount = obj.indexCount;
        commands[cmdIdx].instanceCount = 1;
        commands[cmdIdx].firstIndex = obj.firstIndex;
        commands[cmdIdx].vertexOffset = obj.vertexOffset;
        commands[cmdIdx].firstInstance = idx; // used as object ID in vertex shader
    }
}
