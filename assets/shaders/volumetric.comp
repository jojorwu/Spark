#version 450
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (binding = 0, rgba16f) uniform writeonly image2D volumetricFog;
layout (binding = 1) uniform sampler2D depthBuffer;
layout (binding = 2) uniform sampler2DArray shadowMap;

layout (set = 0, binding = 0) uniform GlobalUBO {
    mat4 viewProj;
    mat4 lightViewProj[4];
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 frustum[6];
    vec4 cascadeSplits;
} global;

layout(push_constant) uniform FogParams {
    vec3 color;
    float density;
    float height_falloff;
    vec3 padding;
} params;

float calculateShadow(vec3 worldPos, float linearDepth) {
    uint cascadeIdx = 0;
    for (uint i = 0; i < 3; ++i) {
        if (linearDepth > global.cascadeSplits[i]) {
            cascadeIdx = i + 1;
        }
    }
    vec4 shadowCoord = global.lightViewProj[cascadeIdx] * vec4(worldPos, 1.0);
    shadowCoord.xyz /= shadowCoord.w;
    shadowCoord.xy = shadowCoord.xy * 0.5 + 0.5;
    float pcfDepth = texture(shadowMap, vec3(shadowCoord.xy, cascadeIdx)).r;
    return shadowCoord.z > pcfDepth ? 0.0 : 1.0;
}

vec3 worldPosFromDepth(float depth, vec2 uv) {
    vec4 clipSpacePos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldSpacePos = global.invViewProj * clipSpacePos;
    return worldSpacePos.xyz / worldSpacePos.w;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    vec2 size = imageSize(volumetricFog);
    if (pos.x >= size.x || pos.y >= size.y) return;

    vec2 uv = (vec2(pos) + 0.5) / size;
    float depth = texture(depthBuffer, uv).r;
    vec3 worldPos = worldPosFromDepth(depth, uv);
    vec3 rayPos = global.cameraPos.xyz;
    vec3 rayDir = worldPos - rayPos;
    float dist = length(rayDir);
    rayDir /= dist;

    float totalDensity = 0.0;
    float totalScattering = 0.0;
    const int STEPS = 32;
    float stepLen = dist / float(STEPS);

    for (int i = 0; i < STEPS; ++i) {
        vec3 p = rayPos + rayDir * stepLen * (float(i) + 0.5);

        // Exponential height fog
        float heightDensity = exp(-params.height_falloff * p.y);
        float currentDensity = params.density * heightDensity;

        // Shadowing
        float linearDepth = length(p - rayPos) / 100.0; // Normalized for CSM splits
        float shadow = calculateShadow(p, linearDepth);

        totalScattering += currentDensity * shadow * stepLen;
        totalDensity += currentDensity * stepLen;
    }

    // Beer-Lambert law for extinction
    float transmission = exp(-totalDensity);
    vec3 fogResult = params.color * totalScattering;

    imageStore(volumetricFog, pos, vec4(fogResult, 1.0 - transmission));
}
