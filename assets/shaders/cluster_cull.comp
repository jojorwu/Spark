#version 450

layout (local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

struct ClusterAABB {
    vec4 min;
    vec4 max;
};

struct Light {
    vec4 pos;         // xyz = position, w = range
    vec4 dir;         // xyz = direction, w = type
    vec4 col;         // xyz = color, w = intensity
    vec4 spotAngles;  // xy = inner/outer (cos)
};

struct LightGrid {
    uint offset;
    uint count;
};

layout (std430, set = 0, binding = 0) readonly buffer ClusterBuffer {
    ClusterAABB clusters[];
};

layout (std430, set = 0, binding = 1) readonly buffer LightBuffer {
    Light lights[];
};

layout (std430, set = 0, binding = 2) writeonly buffer LightGridBuffer {
    LightGrid lightGrids[];
};

layout (std430, set = 0, binding = 3) buffer GlobalIndexList {
    uint globalIndexList[];
};

layout (std430, set = 0, binding = 4) buffer GlobalIndexCounter {
    uint globalIndexCounter;
};

layout (push_constant) uniform PushConstants {
    mat4 view;
    uint lightCount;
} push;

// Shared memory for tiled light culling
shared Light sharedLights[256];

bool intersectSphereAABB(vec3 center, float radius, vec3 minB, vec3 maxB) {
    float sqDist = 0.0;
    for (int i = 0; i < 3; i++) {
        float v = center[i];
        if (v < minB[i]) sqDist += (minB[i] - v) * (minB[i] - v);
        if (v > maxB[i]) sqDist += (v - maxB[i]) * (v - maxB[i]);
    }
    return sqDist <= (radius * radius);
}

void main() {
    uint clusterIndex = gl_GlobalInvocationID.x +
                        gl_GlobalInvocationID.y * 16 +
                        gl_GlobalInvocationID.z * 16 * 16;

    if (gl_GlobalInvocationID.x >= 16 || gl_GlobalInvocationID.y >= 16 || gl_GlobalInvocationID.z >= 24) return;

    ClusterAABB cluster = clusters[clusterIndex];
    uint visibleLightCount = 0;
    uint visibleLightIndices[128]; // Max lights per cluster

    uint numBatches = (push.lightCount + 255) / 256;
    for (uint batch = 0; batch < numBatches; batch++) {
        uint lightIdx = batch * 256 + gl_LocalInvocationIndex;
        if (lightIdx < push.lightCount) {
            sharedLights[gl_LocalInvocationIndex] = lights[lightIdx];
        }

        barrier(); // Wait for workgroup to load light batch

        uint lightsInBatch = min(256, push.lightCount - batch * 256);
        for (uint i = 0; i < lightsInBatch; i++) {
            Light l = sharedLights[i];
            vec3 center = (push.view * vec4(l.pos.xyz, 1.0)).xyz;
            float radius = l.pos.w; // Range is in pos.w in LD struct

            if (intersectSphereAABB(center, radius, cluster.min.xyz, cluster.max.xyz)) {
                if (visibleLightCount < 128) {
                    visibleLightIndices[visibleLightCount++] = batch * 256 + i;
                }
            }
        }

        barrier(); // Ensure all threads finished testing before loading next batch
    }

    uint offset = atomicAdd(globalIndexCounter, visibleLightCount);
    for (uint i = 0; i < visibleLightCount; i++) {
        globalIndexList[offset + i] = visibleLightIndices[i];
    }

    lightGrids[clusterIndex].offset = offset;
    lightGrids[clusterIndex].count = visibleLightCount;
}
